    "mcp",
    "postman",
    "har",
    "sqlite",
    "web-automation",
    "claude-code"
  ],
  "homepage": "https://declick.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucsandman/declick.git"
  },
  "bugs": "https://github.com/ucsandman/declick/issues",
