{
  "name": "declick",
  "version": "0.4.0",
  "description": "Compile an API, an MCP server, or a database into a CLI your agent can run. Nine engines, one output contract.",
  "type": "module",
  "bin": {
    "declick": "bin/declick.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "qa": "bash scripts/qa-real-specs.sh",
    "test:live": "node --test \"test/live/*.test.mjs\"",
    "ui": "node bin/declick.mjs ui",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cli",
    "agents",
    "automation",
    "windows",
    "ui-automation",
    "openapi",
    "swagger",
